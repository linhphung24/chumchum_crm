# ============================================================
# ChumChum CRM — Biến môi trường (copy thành .env ở gốc repo khi deploy VPS)
# Dev local: chỉ cần `docker compose up -d` (postgres) + apps/api/.env
# Hướng dẫn deploy đầy đủ: docs/DEPLOY-VPS.md
# ============================================================

# --- Hạ tầng (docker-compose) ---
POSTGRES_USER=chumchum
POSTGRES_PASSWORD=doi-mat-khau-manh-truoc-khi-len-vps
POSTGRES_DB=chumchum

# --- Server (apps/api) ---
PORT=4000
NODE_ENV=production
# Dev: http://localhost:3000 | Production: https://chat.chumchumbakery.com
CORS_ORIGINS=https://chat.chumchumbakery.com
# URL public của API và của Web (dùng cho luồng OAuth Zalo OA redirect về)
PUBLIC_API_BASE_URL=https://api.chumchumbakery.com
FRONTEND_URL=https://chat.chumchumbakery.com

# --- Database (apps/api) ---
# Trong docker-compose dùng host `postgres`; chạy ngoài docker dùng `localhost`
DATABASE_URL="postgresql://chumchum:doi-mat-khau-manh-truoc-khi-len-vps@postgres:5432/chumchum?schema=public"

# --- Web (apps/web) — URL public của API, bake vào build ---
NEXT_PUBLIC_API_URL=https://api.chumchumbakery.com

# --- Auth ---
# Tạo bằng: openssl rand -hex 32
JWT_SECRET=doi-mat-khau-nay-truoc-khi-len-production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Web Push (thông báo PWA trên điện thoại) ---
# Sinh bằng: npm run gen:vapid -w apps/api → dán 2 giá trị vào đây rồi restart api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@chumchumbakery.com

# ============ KÊNH (để trống = chế độ MOCK để test) ============

# --- Zalo OA (https://developers.zalo.me) ---
ZALO_OA_ID=
ZALO_OA_WEBHOOK_VERIFY_TOKEN=
# Tạo app trên developers.zalo.me (Quản lý ứng dụng) → điền 2 giá trị dưới đây
# để bật nút "Đăng nhập Zalo cấp quyền" (1-cú-click) + tự làm mới token mỗi ngày:
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
# (Hiếm khi cần) Ghi đè redirect URI nếu app Zalo yêu cầu URL khác:
# ZALO_OA_REDIRECT_URI=https://api.chumchumbakery.com/channels/zalo-oa/oauth/callback

# --- Zalo cá nhân (KHÔNG CHÍNH THỨC - rủi ro khóa tài khoản!) ---
# Bridge za-go tự host (xem bridges/zalo-za-go/README.md). Bật service:
#   docker compose --profile zalo-personal up -d --build zalo-bridge
# Trong app điền Bridge URL = http://zalo-bridge:4100 + API Key dưới đây.
ZALO_BRIDGE_API_KEY=
ZALO_BRIDGE_PHONE=
ZALO_BRIDGE_PASSWORD=
ZALO_PERSONAL_BRIDGE_URL=
ZALO_PERSONAL_BRIDGE_API_KEY=

# --- Facebook Messenger + Comment (https://developers.facebook.com) ---
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Instagram Messaging (Meta, gắn IG Business vào Page) ---
IG_VERIFY_TOKEN=

# --- TikTok Business Messaging (https://business-api.tiktok.com) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_VERIFY_TOKEN=

# --- Shopee Open Platform (https://open.shopee.com) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_IDS=
SHOPEE_WEBHOOK_KEY=

# --- Trello (https://trello.com/power-ups/admin) ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_WEBHOOK_CALLBACK_URL=
