# ChumChum API — môi trường dev
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Dev: PostgreSQL chạy qua `docker compose up -d` (từ gốc repo)
DATABASE_URL="postgresql://chumchum:chumchum@localhost:5432/chumchum?schema=public"

JWT_SECRET=chumchum-dev-secret-doi-truoc-khi-production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=30

# Kênh để trống = MOCK (test inbox không cần đăng ký API)
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
