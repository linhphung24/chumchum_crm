FB_APP_SECRET=
FB_VERIFY_TOKEN=chumchum-verify
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_VERIFY_TOKEN=chumchum-verify
TIKTOK_ACCESS_TOKEN=
SHOPEE_PARTNER_ID=
